# Local MongoDB (Docker): mongodb://127.0.0.1:27017/lumina
# Leave empty to use in-memory MongoDB for a quick local demo (no Docker needed)
MONGODB_URI=mongodb://127.0.0.1:27017/lumina

# Required — use a long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_APP_NAME=Lumina
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=15
ADMIN_EMAIL=admin@lumina.studio
